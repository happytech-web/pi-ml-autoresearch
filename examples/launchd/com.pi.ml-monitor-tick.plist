<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pi.ml-monitor-tick</string>

  <!-- Replace every /ABSOLUTE/... value before installing with launchctl. -->
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>/ABSOLUTE/PATH/TO/pi-ml-autoresearch/harness/ml-monitor-tick.mjs</string>
    <string>--schedule</string>
    <string>/ABSOLUTE/PATH/TO/campaign/monitor-schedule.json</string>
    <string>--command</string>
    <string>/ABSOLUTE/PATH/TO/project-monitor-bridge</string>
    <string>--campaign</string>
    <string>/ABSOLUTE/PATH/TO/campaign</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/PATH/TO/campaign</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/tmp/pi-ml-monitor-tick.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/pi-ml-monitor-tick.error.log</string>
</dict>
</plist>
